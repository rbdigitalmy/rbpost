# ==============================================================================
# RB POST — LIVE MODE ENVIRONMENT CONFIGURATION (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Database, Authentication & Storage)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY — generate your own; never commit real values
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. AI GENERATION (OpenRouter / OpenAI)
# Get key from: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
COPY_MODEL=openai/gpt-4.1-mini
IMAGE_MODEL=openai/gpt-image-2.5-flare

# ------------------------------------------------------------------------------
# 5. META / THREADS / INSTAGRAM API
# Get credentials from: https://developers.facebook.com/apps
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/threads/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Optional: Instagram Graph API version (default v25.0). Meta retires versions ~2 years after release.
INSTAGRAM_GRAPH_VERSION=
# Webhooks (comment/DM/Threads-reply automation). Callback URLs:
#   https://<domain>/api/webhooks/instagram   and   https://<domain>/api/webhooks/threads
# Verify token: any random string; enter the same value in the Meta dashboard webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Optional: secret used to sign webhook payloads, if it differs from INSTAGRAM_APP_SECRET / META_APP_SECRET.
# Signatures (X-Hub-Signature-256) are checked against every configured secret.
META_WEBHOOK_APP_SECRET=

# ------------------------------------------------------------------------------
# 6. STRIPE BILLING & SUBSCRIPTIONS
# Get keys from: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ------------------------------------------------------------------------------
# 7. ADMIN & PLATFORM METRICS
# ------------------------------------------------------------------------------
ADMIN_USER_IDS=
USD_MYR_RATE=4.5
MONTHLY_INFRA_COST_MYR=0

# ------------------------------------------------------------------------------
# 8. OPERATIONS (Optional — HTTPS webhook for cron/runtime failure alerts)
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
